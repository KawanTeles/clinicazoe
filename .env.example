# URL e chaves do projeto Supabase (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de service role — bypassa RLS. NUNCA expor no client, só usada em Server
# Actions/rotas server-side (createAdminClient()).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública base da aplicação (sem barra final), usada para montar links em
# notificações/e-mails/WhatsApp. Se ausente, cai em um fallback fixo no código
# (src/lib/site-url.ts) — defina sempre em produção para apontar pro domínio real.
NEXT_PUBLIC_APP_URL=

# Chave usada só para criptografar a API key do provedor de IA (tabela ai_settings)
# antes de gravar no banco. Gere com: openssl rand -hex 32
# As chaves da OpenAI/Anthropic/Gemini NÃO vão aqui — são cadastradas pelo admin
# em Configurações -> Inteligência Artificial e guardadas encriptadas no banco.
AI_SECRET_KEY=
